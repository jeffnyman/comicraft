<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- the packages carry XML documentation. The missing-comment warning is off here, and back on
         for ComiCraft.Comics, whose public API is documented in full. (The SDK derives the
         documentation file name before Directory.Build.targets is read, so this lives here.) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>ComiCraft</Product>
    <Authors>Jeff Nyman</Authors>
    <Copyright>Copyright (c) Jeff Nyman.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jeffnyman/comicraft</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jeffnyman/comicraft</PackageProjectUrl>
    <!-- dotnet pack -p:VersionSuffix=alpha.2 for the next prerelease; an empty suffix is a release -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <!-- nuget.org renders a package's README as Markdown alone, without the HTML the GitHub one
         uses: the packages carry NUGET.md, the same in Markdown, with links that work there -->
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <!-- the viewer's own icon, its 128-pixel image (tools/icon writes it), for nuget.org -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>comics;comic-book;cbz;cbr;cb7;comicinfo;metron;viewer;reader;sdl3</PackageTags>
    <PackageReleaseNotes>The first release: the viewer, the conversions to CBZ and to PDF, ComicInfo.xml editing, and lookups on Metron.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)NUGET.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
